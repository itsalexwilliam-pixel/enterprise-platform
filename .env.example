# ============================================================
# Enterprise Email Validation Platform - Environment Config
# ============================================================

APP_NAME="Email Validator Pro"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=UTC

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
DB_CONNECTION=mysql
DB_HOST=mysql_master
DB_PORT=3306
DB_DATABASE=email_validator
DB_USERNAME=ev_user
DB_PASSWORD=STRONG_PASSWORD_HERE
DB_ROOT_PASSWORD=ROOT_STRONG_PASSWORD

# Read Replica (MySQL Slave)
DB_READ_HOST=mysql_replica
DB_READ_PORT=3306

# Replication
REPL_PASSWORD=REPL_STRONG_PASSWORD

# ============================================================
# CACHE & SESSIONS
# ============================================================
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# ============================================================
# REDIS CONFIGURATION
# ============================================================
REDIS_HOST=redis
REDIS_PASSWORD=REDIS_STRONG_PASSWORD
REDIS_PORT=6379
REDIS_DB=0

# Redis Databases
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_DB=3
REDIS_RATE_LIMIT_DB=4

# ============================================================
# QUEUE CONFIGURATION
# ============================================================
QUEUE_CONNECTION=rabbitmq
QUEUE_FAILED_DRIVER=database

# ============================================================
# RABBITMQ CONFIGURATION
# ============================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=email_validator
RABBITMQ_USER=ev_admin
RABBITMQ_PASSWORD=RABBITMQ_STRONG_PASSWORD

# Queue Names
QUEUE_SMTP=smtp_validation
QUEUE_DNS=dns_validation
QUEUE_BULK=bulk_processing
QUEUE_WEBHOOKS=webhooks
QUEUE_REPORTS=reports

# ============================================================
# MAIL CONFIGURATION
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@yourdomain.com
MAIL_PASSWORD=MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="Email Validator Pro"

# ============================================================
# STRIPE BILLING
# ============================================================
STRIPE_KEY=pk_live_YOUR_STRIPE_PUBLIC_KEY
STRIPE_SECRET=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ============================================================
# SMTP VALIDATION SETTINGS
# ============================================================
SMTP_HELO_DOMAIN=mail.yourdomain.com
SMTP_FROM_EMAIL=verify@yourdomain.com
SMTP_TIMEOUT=10
SMTP_MAX_RETRIES=2
SMTP_CONNECT_TIMEOUT=5

# ============================================================
# DNS SETTINGS
# ============================================================
DNS_TIMEOUT=5
DNS_NAMESERVERS=8.8.8.8,1.1.1.1,9.9.9.9
DNS_CACHE_TTL=3600

# ============================================================
# VALIDATION SETTINGS
# ============================================================
VALIDATION_CONCURRENT_JOBS=50
BULK_CHUNK_SIZE=1000
BULK_MAX_EMAILS=10000000
API_RATE_LIMIT_PER_MINUTE=100
API_RATE_LIMIT_PER_DAY=10000

# ============================================================
# SECURITY
# ============================================================
JWT_SECRET=GENERATE_STRONG_JWT_SECRET_HERE
JWT_TTL=1440
SANCTUM_STATEFUL_DOMAINS=yourdomain.com

# ============================================================
# MONITORING
# ============================================================
GRAFANA_PASSWORD=GRAFANA_STRONG_PASSWORD
PROMETHEUS_ENABLED=true

# ============================================================
# STORAGE
# ============================================================
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=email-validator-files

# ============================================================
# FEATURE FLAGS
# ============================================================
FEATURE_SOCIAL_LOGIN=true
FEATURE_TWO_FACTOR=true
FEATURE_TEAM_ACCOUNTS=true
FEATURE_RESELLER=true
FEATURE_WHITE_LABEL=true
FEATURE_AI_SCORING=true
