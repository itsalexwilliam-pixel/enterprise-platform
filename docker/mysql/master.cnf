# ============================================================
# MySQL Master Configuration
# Optimized for Enterprise Email Validation Platform
# ============================================================

[mysqld]
# Replication
server-id           = 1
log_bin             = /var/log/mysql/mysql-bin.log
binlog_format       = ROW
binlog_row_image    = MINIMAL
binlog_expire_logs_seconds = 604800
max_binlog_size     = 100M
sync_binlog         = 1

# Performance
innodb_buffer_pool_size     = 1G
innodb_buffer_pool_instances = 2
innodb_log_file_size        = 512M
innodb_log_buffer_size      = 64M
innodb_flush_log_at_trx_commit = 1        # Full ACID (change to 2 for performance)
innodb_flush_method         = O_DIRECT
innodb_file_per_table       = 1
innodb_io_capacity          = 2000
innodb_io_capacity_max      = 4000
innodb_read_io_threads      = 8
innodb_write_io_threads     = 8

# Connection Pool
max_connections             = 500
max_connect_errors          = 10000
connect_timeout             = 10
wait_timeout                = 3600
interactive_timeout         = 3600

# Thread Cache
thread_cache_size           = 32
thread_stack                = 192K

# Query Cache (disabled in MySQL 8.0, use ProxySQL instead)
# query_cache_type = 0

# Temporary Tables
tmp_table_size              = 128M
max_heap_table_size         = 128M

# Sorting & Joins
sort_buffer_size            = 4M
join_buffer_size            = 4M
read_buffer_size            = 2M
read_rnd_buffer_size        = 8M

# Slow Query Log
slow_query_log              = 1
slow_query_log_file         = /var/log/mysql/slow.log
long_query_time             = 1
log_queries_not_using_indexes = 1

# Character Set
character_set_server        = utf8mb4
collation_server            = utf8mb4_unicode_ci

# SQL Mode
sql_mode                    = STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO

# Large packet for bulk operations
max_allowed_packet          = 64M

# Open Files
open_files_limit            = 65535
table_open_cache            = 4096
table_definition_cache      = 2048
